# snehal.fyi Admin Dashboard & GitHub API Sync
# Copy these to Vercel Environment Variables: https://vercel.com/snehalreddy23/snehal-fyi/settings/environment-variables

# Passcode to unlock /admin dashboard (default if unset: snehal2025)
ADMIN_PASSCODE=snehal2025

# GitHub Personal Access Token (classic with 'repo' scope)
# Allows the dashboard to directly edit src/data/jobs.json and commit to GitHub
GITHUB_TOKEN=

# GitHub Repository Information
GITHUB_OWNER=snehalreddy23
GITHUB_REPO=snehal.fyi
GITHUB_BRANCH=main

# Telegram Bot Auto-Posting (@snehal_fyi)
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@snehal_fyi
